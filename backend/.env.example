# OpenAI-compatible provider configuration. LLM_API_KEY is optional.
# The API continues to work in safe local fallback mode when it is blank.
LLM_PROVIDER=siliconflow
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1400

# MediConsensus orchestration. All roles fall back to LLM_MODEL unless overridden.
CONSENSUS_ENABLED=true
CONSENSUS_API_KEY=
CONSENSUS_BASE_URL=
CONSENSUS_TIMEOUT_SECONDS=45
CONSENSUS_MAX_TOKENS=1400
CONSENSUS_TEMPERATURE=0
CONSENSUS_DEBATE_MODEL=
CONSENSUS_EVIDENCE_JUDGE_MODEL=
CONSENSUS_SAFETY_JUDGE_MODEL=
CONSENSUS_CONFLICT_JUDGE_MODEL=
CONSENSUS_CONFIDENCE_JUDGE_MODEL=
CONSENSUS_SYNTHESIS_MODEL=

# Synthetic Western fixtures are disabled by default and must be explicitly enabled for research.
ALLOW_WEST_FIXTURE=false

# Future real MediRAG-West adapter. No endpoint is assumed or called by the current pilot.
WEST_API_BASE_URL=
WEST_API_TIMEOUT_SECONDS=30

# Retrieval configuration. Thresholds are experimental and should be tuned with evaluation data.
RETRIEVAL_MODE=hybrid
TOP_K_CANDIDATES=10
TOP_K_EVIDENCE=4
MIN_RELEVANCE_SCORE=0.18
RETRIEVAL_TIMEOUT_SECONDS=20

# Optional remote semantic retrieval and reranking.
# Disabled by default so the prototype does not silently make extra provider calls.
ENABLE_SEMANTIC_RETRIEVAL=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
ENABLE_RERANK=true
ENABLE_REMOTE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Deployment/local frontend configuration.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PORT=8000
