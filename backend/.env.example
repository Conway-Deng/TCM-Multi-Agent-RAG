# Core LLM (leave LLM_API_KEY blank for deterministic mock mode)
LLM_PROVIDER=siliconflow
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1400

# Model-role aliases (blank values fall back to LLM_MODEL)
PLANNER_MODEL=
SPECIALIST_MODEL=
DEBATE_MODEL=
CRITIC_MODEL=
REVISION_MODEL=
EVIDENCE_JUDGE_MODEL=
HALLUCINATION_JUDGE_MODEL=
SAFETY_JUDGE_MODEL=
CONFLICT_JUDGE_MODEL=
CONFIDENCE_JUDGE_MODEL=
PROVENANCE_JUDGE_MODEL=
SYNTHESIS_MODEL=
EXTERNAL_EVALUATOR_MODEL=

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=local-hash-embedding-v1

# Reranking
RERANK_PROVIDER=local
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=local-overlap-reranker-v1

# Vector store
VECTOR_STORE_PROVIDER=local
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tcm-research

# Research
RESEARCH_MODE=true
RESEARCH_REAL_LLM_ENABLED=false
RESEARCH_MAX_PARALLEL_CALLS=4
RESEARCH_REPEAT_COUNT=1
RESEARCH_RANDOM_SEED=20260815
RESEARCH_STORE_RAW_QUERY=false
RESEARCH_RESULTS_DIR=research/results

# Corpus runtime profile. Public/default mode is the 16-entry fixture. The
# local research startup script overrides these with required + the local path.
TCM_CORPUS_MODE=legacy
TCM_CORPUS_PATH=

# Safety
STRICT_MEDICAL_SAFETY=true
ALLOW_UNREVIEWED_SOURCES=false

# Deployment
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PORT=8000
