.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Research runs are private/local by default. Publish selected artifacts intentionally.
research/results/*
!research/results/.gitkeep
backend/research/results/*
!backend/research/results/.gitkeep
*.sqlite3
.env.local
backend/.env.local


backend/.env
backend/.venv/

# Third-party TCM corpus material is local-only unless redistribution is
# explicitly cleared. Keep raw, normalized, and built restricted data out of Git;
# commit only configs, code, manifests/reports without source record content, and
# placeholder files.
research/corpus/raw/**
!research/corpus/raw/.gitkeep
research/corpus/normalized/**
!research/corpus/normalized/.gitkeep
research/corpus/tcm_v1/**
!research/corpus/tcm_v1/.gitkeep
# The frozen v1 chunk file is explicitly deployed for paper-faithful replay.
!research/corpus/tcm_v1/chunks.jsonl
# PMC OA source XML and normalized article intermediates are local build inputs.
# Final pilot registry/chunks/manifests/reports stay visible for deliberate review.
research/corpus/west_v0_1/raw/**
research/corpus/west_v0_1/normalized/**
research/corpus/west_v0_1/chunks.jsonl
research/replays/
research/benchmarks/external/**
!research/benchmarks/external/.gitkeep

# Formal evaluation local execution artifacts and persistent embedding caches.
# Runs can contain raw evidence excerpts and must not be accidentally committed (copyright safety).
# Caches contain derived embedding/query vectors and must remain local.
research/experiments/western_formal_v0_1/runs/**
research/experiments/western_formal_v0_1/cache/**
